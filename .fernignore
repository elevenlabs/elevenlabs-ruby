# Specify files that shouldn't be modified by Fern
README.md

# Hand-written agent workflows-as-code builder (a layer on top of the generated client) and its
# shared cross-SDK conformance fixtures.
lib/elevenlabs/agent_workflows.rb
lib/elevenlabs/agent_workflows/
test/elevenlabs/agent_workflows/

# Hand-written agent tools-as-code builder (webhook, client and system tools on top of the generated
# client; reuses the workflow builder's Destination and wire helpers) and its shared conformance fixtures.
lib/elevenlabs/agent_tools.rb
lib/elevenlabs/agent_tools/
test/elevenlabs/agent_tools/

# Hand-written agents-as-code builder: the Agent builder, AgentProject (the ElevenLabs CLI's project layout)
# and agents.push/pull, which it prepends to the generated agents client so no generated file changes. Its
# tests vendor the shared cli-graph project fixture from elevenlabs-js (docs/agents-as-code/fixtures).
lib/elevenlabs/agent_builder.rb
lib/elevenlabs/agent_builder/
test/elevenlabs/agent_builder/

# Hand-written webhook signature verifier (Fern's generated verifier can't parse
# the compound `t=...,v0=...` header).
lib/elevenlabs/webhooks/verifier.rb
test/elevenlabs/webhooks/verifier_test.rb

# Hand-written Flows `create_and_wait` (polls a generation or template run until it finishes). It adds
# the method to the generated flow clients by including a module, so no generated file is changed.
lib/elevenlabs/flows/create_and_wait.rb
test/elevenlabs/flows/create_and_wait_test.rb

# Hand-written parsed music `compose_detailed`. `POST /v1/music/detailed` returns a `multipart/mixed`
# body (JSON metadata + audio) that the generator doesn't parse. It prepends a module to the generated
# music client that runs the generated method unchanged and splits the parts.
lib/elevenlabs/music/compose_detailed.rb
test/elevenlabs/music/compose_detailed_test.rb

# Hand-written Speech Engine server model (the generator only produces the
# upstream WS client; the inbound server side is hand-written).
lib/elevenlabs/speech_engine/jwt_verifier.rb
lib/elevenlabs/speech_engine/conversation_message.rb
lib/elevenlabs/speech_engine/session.rb
lib/elevenlabs/speech_engine/server.rb
lib/elevenlabs/speech_engine/resource.rb
test/elevenlabs/speech_engine/jwt_verifier_test.rb
test/elevenlabs/speech_engine/session_test.rb
test/elevenlabs/speech_engine/server_test.rb
test/elevenlabs/speech_engine/resource_test.rb

# The org allowlist only permits rubygems/configure-rubygems-credentials pinned to a commit hash.
.github/workflows/ci.yml
